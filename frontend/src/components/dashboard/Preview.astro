---
import BoxThree from "../ui/BoxThree.astro";
import Slash from "../ui/Slash.astro";
import { FilePreview } from "../preview/files/Preview.tsx";
import PasteView from "../preview/paste-view/PasteView.astro";
import Info from "../preview/info/Info.astro";
---

<BoxThree>
    <div slot="one" class="flex w-full flex-col items-center justify-start gap-2 overflow-visible p-3">
        <h1 class="font-ibm text-xl 2xl:text-2xl text-center border-b border-line m-4 self-stretch truncate">
            Attached Files
        </h1>
        <FilePreview client:load />
    </div>

    <div slot="two" class="w-full min-w-0 overflow-visible 2xl:h-full 2xl:min-h-0 2xl:overflow-hidden">
        <PasteView />
    </div>

    <div slot="three" class="w-full overflow-visible">
        <h1 class="font-ibm text-xl 2xl:text-2xl text-center border-b border-line m-4 truncate">
            Paste Info
        </h1>
        <Info />
    </div>
</BoxThree>
<Slash />