---
import Input from "../../ui/Input.astro";
---

<form id="unlock-form" class="flex flex-col gap-3">
    <Input
        id="unlock-password"
        name="password"
        type="password"
        placeholder="Password"
        toggle
        required
    />
    <button
        type="submit"
        class="w-full rounded-md border border-line bg-rose px-4 py-2
            font-ibm text-sm text-on-rose transition hover:border-line hover:bg-rose-hover
            disabled:cursor-not-allowed disabled:opacity-50"
    >
        Unlock
    </button>
    <p id="unlock-error" class="font-ibm text-xs text-danger"></p>
</form>

<script>
    import { getSlug } from "../../../lib/payload/api";
    import { unlock } from "../../../lib/payload/private/unlock";

    const form = document.querySelector<HTMLFormElement>("#unlock-form");
    const input = document.querySelector<HTMLInputElement>("#unlock-password");
    const error = document.querySelector<HTMLParagraphElement>("#unlock-error");
    const submit = form?.querySelector<HTMLButtonElement>("button[type=submit]");

    form?.addEventListener("submit", async (event) => {
        event.preventDefault();
        if (!input || !error || !submit) return;

        submit.disabled = true;
        submit.textContent = "Unlocking…";
        error.textContent = "";

        try {
            await unlock(getSlug(), input.value);
            input.value = "";
        } catch {
            error.textContent = "Wrong password";
        } finally {
            submit.disabled = false;
            submit.textContent = "Unlock";
        }
    });
</script>