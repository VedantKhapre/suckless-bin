---
import Input from "../../ui/Input.astro";
import RadioPill from "./RadioPill.astro";
---

<div>
    <p class="mb-3 font-ibm text-base">Visibility</p>

    <div class="flex flex-wrap gap-2">
        <RadioPill
            name="visibility"
            value="public"
            label="Public"
            checked
            checkedClass="peer-checked:bg-public peer-checked:text-on-public"
        />
        <RadioPill
            name="visibility"
            value="private"
            label="Private"
            checkedClass="peer-checked:bg-private peer-checked:text-on-private"
        />
    </div>
    <div>
    <Input
        class="mt-3"
        id="password"
        name="password"
        type="password"
        minlength={8}
        placeholder="Password"
        toggle
        disabled
    />
    <piix-pal id="pal-buff" pal="buff"></piix-pal>
    </div>
</div>

<script>
    const radios = document.querySelectorAll<HTMLInputElement>('input[name="visibility"]');
    const password = document.querySelector<HTMLInputElement>("#password");

    function sync() {
        if (!password) return;
        const isPrivate =
            document.querySelector<HTMLInputElement>('input[name="visibility"]:checked')
                ?.value === "private";
        password.disabled = !isPrivate;
        if (!isPrivate) password.value = "";
    }

    sync();
    radios.forEach((radio) => radio.addEventListener("change", sync));
</script>