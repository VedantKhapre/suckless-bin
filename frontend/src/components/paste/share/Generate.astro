---
import Link from "./Link.astro";
---

<div>
    <button
        id="generate-btn"
        type="button"
        class="w-full rounded-md border border-line bg-amber px-4 py-2
            font-ibm text-sm text-on-amber transition hover:border-line hover:bg-amber-hover"
    >
        Create
    </button>
    <ul id="generate-errors" class="mt-2 list-disc pl-5 font-ibm text-xs text-danger"></ul>
    <Link />
</div>

<script>
    import { collect, validate } from "../../../lib/payload/collect";
    import { buildPublicPayload } from "../../../lib/payload/public/build";
    import { buildPrivatePayload } from "../../../lib/payload/private/build";
    import { sendPaste, sendFile } from "../../../lib/payload/api";

    const PREVIEW_PATH = "/";

    const errorList = document.querySelector<HTMLUListElement>("#generate-errors");
    const showLink = (url: string | null) => 
      window.dispatchEvent(new CustomEvent("paste:link", { detail: url }));

    function showErrors(errors: string[]) {
        errorList?.replaceChildren(
            ...errors.map((message) => {
                const li = document.createElement("li");
                li.textContent = message;
                return li;
            }),
        );
    }

    document.querySelector("#generate-btn")?.addEventListener("click", async () => {
        const collected = collect();
        const errors = validate(collected);

        showErrors(errors);
        showLink(null);
        if (errors.length > 0) return;

        try {
            const payload =
                collected.visibility === "public"
                    ? buildPublicPayload(collected)
                    : await buildPrivatePayload(collected);

            const { slug } = await sendPaste(payload);

            await Promise.all(
                collected.files.map(async (file, i) =>
                    sendFile(slug, i, await file.arrayBuffer()),
                ),
            );

            showLink(`${location.origin}${PREVIEW_PATH}${slug}`);
        } catch {
            showErrors(["Could not reach the server (is `bun run mock` running?)"]);
        }
    });
</script>