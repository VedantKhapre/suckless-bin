<div id="link-box" class="mt-3 hidden">
    <div class="flex items-stretch overflow-hidden rounded-md border border-line">
        <a
            id="link-url"
            href="#"
            target="_blank"
            rel="noopener noreferrer"
            class="min-w-0 flex-1 truncate px-3 py-2 font-ibm text-sm hover:underline"
        ></a>

        <button
            id="link-copy"
            type="button"
            title="Copy link"
            class="flex shrink-0 cursor-pointer items-center justify-center border-l border-line
                px-3 transition hover:bg-black/5 dark:hover:bg-white/10"
        >
            <svg
                id="link-copy-icon"
                class="size-4"
                viewBox="0 0 24 24"
                fill="none"
                stroke="currentColor"
                stroke-width="2"
                stroke-linecap="round"
                stroke-linejoin="round"
            >
                <rect x="8" y="8" width="14" height="14" rx="2"></rect>
                <path d="M4 16c-1.1 0-2-.9-2-2V4c0-1.1.9-2 2-2h10c1.1 0 2 .9 2 2"></path>
            </svg>
            <svg
                id="link-check-icon"
                class="hidden size-4"
                viewBox="0 0 24 24"
                fill="none"
                stroke="currentColor"
                stroke-width="2"
                stroke-linecap="round"
                stroke-linejoin="round"
            >
                <path d="M20 6 9 17l-5-5"></path>
            </svg>
        </button>
    </div>
</div>

<script>
    const box = document.querySelector<HTMLDivElement>("#link-box");
    const anchor = document.querySelector<HTMLAnchorElement>("#link-url");
    const copy = document.querySelector<HTMLButtonElement>("#link-copy");
    const copyIcon = document.querySelector("#link-copy-icon");
    const checkIcon = document.querySelector("#link-check-icon");

    // Generate.astro fires this: a url shows the bar, null hides it
    window.addEventListener("paste:link", (event) => {
        const url = (event as CustomEvent<string | null>).detail;
        if (!box || !anchor) return;

        box.classList.toggle("hidden", !url);
        if (url) {
            anchor.href = url;
            anchor.textContent = url;
            anchor.title = url;
        }
    });

    copy?.addEventListener("click", async () => {
        if (!anchor?.href) return;
        await navigator.clipboard.writeText(anchor.href);

        copyIcon?.classList.add("hidden");
        checkIcon?.classList.remove("hidden");
        setTimeout(() => {
            copyIcon?.classList.remove("hidden");
            checkIcon?.classList.add("hidden");
        }, 1500);
    });
</script>