<div class="flex h-10 shrink-0 items-center justify-between gap-3 border-b border-line px-3">
    <h1 class="min-w-0 truncate font-ibm text-xl">Paste Area</h1>

    <div class="flex min-w-0 items-center justify-end gap-3">
        <span
            id="paste-warn"
            class="min-w-0 truncate whitespace-nowrap font-ibm text-xs text-warning"
        ></span>

        <span
            id="paste-count"
            class="w-40 shrink-0 whitespace-nowrap text-right font-ibm text-xs tabular-nums text-muted-foreground"
        >
            0 / 50,000 chars
        </span>

        <div class="relative shrink-0">
            <button
                id="language-button"
                type="button"
                class="h-7 w-36 appearance-none truncate rounded-md border border-line bg-transparent pr-7 pl-2 text-left font-ibm text-sm outline-none focus-visible:border-line"
            >
                Plain Text
            </button>
            <div
                id="language-dropdown"
                class="absolute top-8 left-0 hidden max-h-48 w-36 overflow-y-auto rounded-md border border-line bg-background shadow-lg z-5 scrollbar-thin scrollbar-thumb-line scrollbar-track-background"
            ></div>
            <svg
                class="pointer-events-none absolute top-1/2 right-2 size-3.5 -translate-y-1/2 text-muted-foreground"
                viewBox="0 0 24 24"
                fill="none"
                stroke="currentColor"
                stroke-width="2"
                stroke-linecap="round"
                stroke-linejoin="round"
            >
                <path d="m6 9 6 6 6-6" />
            </svg>
        </div>
    </div>
</div>

