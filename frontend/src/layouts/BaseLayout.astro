---
import { Font } from "astro:assets";
import "../styles/global.css";
import Nav from "../components/navigation/Nav.astro";

interface Props {
    title: string;
    description?: string;
    image?: string;
    canonicalUrl?: string;
}

const {
    title = "Suckless Bin",
    description = "Suckless Bin is a simple paste sharing service.",
    image = "/og-image.webp",
    canonicalUrl = Astro.url.href,
} = Astro.props;
---
<html lang="en">
    <head>
        <meta charset="utf-8" />
        <meta name="viewport" content="width=device-width, initial-scale=1" />

        <title>{title}</title>
        
        <meta name="description" content={description} />

        <link rel="canonical" href={canonicalUrl} />
        <link rel="icon" href="/favicon.svg" />
        <link rel="apple-touch-icon" href="/apple-touch-icon.png" />

        <meta property="og:title" content={title} />
        <meta property="og:description" content={description} />
        <meta property="og:image" content={new URL(image, Astro.url)} />
        <meta property="og:url" content={canonicalUrl} />
        <meta property="og:type" content="website" />

        <meta name="twitter:card" content="summary_large_image" />
        <meta name="twitter:title" content={title} />
        <meta name="twitter:description" content={description} />
        <meta name="twitter:image" content={new URL(image, Astro.url)} />
        
        <Font cssVariable="--font-ibm" />
        
        <script is:inline>
          try {
            const stored = localStorage.getItem("theme");
            const dark = stored ? stored === "dark" : matchMedia("(prefers-color-scheme: dark)").matches;
            document.documentElement.classList.toggle("dark", dark);
            document.documentElement.style.colorScheme = dark ? "dark" : "light";
          } catch {}
        </script>
        
    </head>

    <body class="bg-background text-foreground">
        <main class="flex min-h-dvh flex-col 2xl:h-dvh 2xl:overflow-hidden">
            <Nav />
            <slot />
        </main>
    </body>
</html>
<script src="https://cdn.jsdelivr.net/npm/piixpal@0.4/piixpal.min.js"></script>